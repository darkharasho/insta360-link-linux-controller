{
  "name": "insta360-link-linux-controller",
  "version": "0.2.1",
  "description": "Control Insta360 Link webcams on Linux",
  "license": "MIT",
  "main": "dist/main/main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkharasho/insta360-link-linux-controller.git"
  },
  "author": "darkharasho",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:app\"",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "dev:app": "npm run build:native && npm run build:main && wait-on tcp:127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json && npm run build:preload",
    "build:preload": "esbuild src/main/preload.cts --bundle --platform=node --format=cjs --external:electron --target=node20 --outfile=dist/main/preload.cjs",
    "build:native": "make -C native/link-xu",
    "build": "npm run build:native && npm run build:main && npm run build:renderer && electron-builder",
    "test": "vitest --maxWorkers=2",
    "test:run": "vitest run --maxWorkers=2",
    "predev": "node scripts/copy-mediapipe.mjs",
    "prebuild:renderer": "node scripts/copy-mediapipe.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.4",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.0",
    "lucide-react": "^1.28.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwind-merge": "^3.6.0"
  }
}
